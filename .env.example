# Copy to .env and adjust. Every value here is a placeholder.
# The app runs end to end with this file untouched: all integrations use mock adapters.

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to false to call the real APIs below. Any integration without credentials is skipped.
MOCK_INTEGRATIONS=true
# Backend port. The React dev server proxies /api/* here (see "proxy" in package.json).
PORT=3002
# SQLite file location. Created by `npm run seed`.
DB_PATH=./data/app.db

# ── Business rules ──────────────────────────────────────────────────────────
# Days after an administrator-type user is imported before their onboarding follow-up is due.
FOLLOW_UP_DEADLINE_DAYS=60
# A user counts as "new" for this many months after their date_entered; older rows are "established".
NEW_USER_WINDOW_MONTHS=6
# Leads with no contact for this many days drop out of the Active Leads count.
STALE_LEAD_DAYS=10

# ── Calendly (scheduling) ───────────────────────────────────────────────────
# Personal access token. Add CALENDLY_TOKEN_<NAME>=... lines to poll more than one account.
CALENDLY_API_TOKEN=your-calendly-token
CALENDLY_API_BASE=https://api.calendly.com

# ── Zoom (meetings, Server-to-Server OAuth app) ─────────────────────────────
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_API_BASE=https://api.zoom.us/v2
ZOOM_OAUTH_URL=https://zoom.us/oauth/token

# ── Zendesk (helpdesk sync on lead conversion + ticket history) ─────────────
# OAuth client with the client-credentials grant.
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_CLIENT_ID=your-zendesk-client-id
ZENDESK_CLIENT_SECRET=your-zendesk-client-secret

# ── Microsoft Graph (Outlook calendar + mail metadata, shared-drive CSV) ────
# App registration using client credentials. Needs Calendars.Read, Mail.ReadBasic.All, Sites.Selected.
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-graph-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_API_BASE=https://graph.microsoft.com/v1.0
GRAPH_LOGIN_BASE=https://login.microsoftonline.com
# Where the daily new-user CSV lives on the shared drive (site or drive id + path within it).
SHARED_DRIVE_SITE_ID=your-site-id
SHARED_DRIVE_FILE_PATH=/Reports/new-users.csv

# ── Support session notes (sibling internal app, optional) ──────────────────
# Backend API used to pull support session history; leave blank to disable.
SUPPORT_SESSIONS_API_URL=http://localhost:3001
# User-facing URL used for "open session" links. Also read by the React build as REACT_APP_SUPPORT_SESSIONS_URL.
SUPPORT_SESSIONS_FRONTEND_URL=http://localhost:3005
REACT_APP_SUPPORT_SESSIONS_URL=

# ── Team ────────────────────────────────────────────────────────────────────
# Optional comma-separated email domains treated as internal when scanning Outlook attendees.
TEAM_EMAIL_DOMAINS=
